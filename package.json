{
  "name": "artoholic-management",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:web": "npm run dev -w @artoholic/web",
    "dev:mobile": "npm run start -w @artoholic/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @artoholic/web",
    "db:migrate": "npm run db:migrate -w @artoholic/web",
    "seed:super-admin": "npm run seed:super-admin -w @artoholic/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
