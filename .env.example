# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://artoholic:artoholic@localhost:5432/artoholic
DATABASE_URL_TEST=postgres://artoholic:artoholic@localhost:5432/artoholic_test

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=artoholic
S3_SECRET_KEY=artoholic-minio
S3_BUCKET=artoholic

APP_BASE_URL=http://localhost:3000
APP_VERSION=0.1.0

# Sessions (spec FR-005a)
WEB_IDLE_MINUTES=60
MOBILE_SESSION_DAYS=30

# Mobile app → API base URL
EXPO_PUBLIC_API_URL=http://localhost:3000

# Secret used to hash password-reset codes (002). Required in production; use a long random value.
OTP_HASH_SECRET=change-me-to-a-long-random-string

# 004: Google Maps Places (warehouse and venue pins). Blank = enter coordinates by hand.
MAPS_API_KEY_WEB=

# 008 notifications
APP_URL=http://localhost:3000
# Encrypts provider secrets (WhatsApp token, SMTP password) at rest. Required in production.
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Push: "expo" sends through Expo's push service (default in production); "mock" writes to dev_outbox.
PUSH_PROVIDER=mock
# Mobile builds: the EAS project id enables push tokens.
EAS_PROJECT_ID=
# WhatsApp and SMTP are configured by the Super Admin in Admin → WhatsApp and email.

# 009: storage driver. "s3" (default) uses S3_*; "memory" is for e2e runs only.
STORAGE_DRIVER=s3

# 010 admin console
# Nightly backup command (02:00 IST); prints a JSON summary. Example: docker run --rm --env-file .env artoholic-backup
BACKUP_COMMAND=
BACKUP_BUCKET=artoholic-backups
# Storage quota shown on the status page (GB). Optional.
STORAGE_QUOTA_GB=
