# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://artoholic:artoholic@localhost:5432/artoholic
DATABASE_URL_TEST=postgres://artoholic:artoholic@localhost:5432/artoholic_test

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=artoholic
S3_SECRET_KEY=artoholic-minio
S3_BUCKET=artoholic

APP_BASE_URL=http://localhost:3000
APP_VERSION=0.1.0

# Sessions (spec FR-005a)
WEB_IDLE_MINUTES=60
MOBILE_SESSION_DAYS=30

# Mobile app → API base URL
EXPO_PUBLIC_API_URL=http://localhost:3000

# Secret used to hash password-reset codes (002). Required in production; use a long random value.
OTP_HASH_SECRET=change-me-to-a-long-random-string
